{
  "name": "selyopass",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p src/contracts/anchor-registry/tsconfig.json && tsc --noEmit -p src/contracts/credential-registry/tsconfig.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:artifact": "playwright test",
    "test:manifests": "node --test scripts/__tests__/*.test.mjs && node scripts/validate-manifests.mjs",
    "check:bindings": "bash scripts/check-bindings.sh"
  },
  "dependencies": {
    "@creit.tech/stellar-wallets-kit": "2.5.0",
    "@stellar/stellar-sdk": "16.1.0",
    "buffer": "6.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "10.8.0",
    "globals": "17.8.0",
    "jsdom": "^26.1.0",
    "typescript": "5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "axios": "1.18.0",
    "protobufjs": "7.6.5",
    "uuid": "11.1.1"
  }
}
